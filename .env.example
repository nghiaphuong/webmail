# ===== PhuongCode Webmail – environment variables =====
# On Hostinger: set these in the Node.js app's Environment variables. Never commit the real .env.

PORT=3000
PUBLIC_URL=https://mail.phuongcode.com
APP_NAME=PhuongCode Mail

# MySQL (hPanel > Databases). On Hostinger use 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000000_webmail
DB_USER=u000000000_webmail
DB_PASSWORD=change-me

# Long random strings (at least 32 characters). ENCRYPTION_KEY encrypts stored mailbox passwords –
# never change it after mailboxes have been created, or stored passwords/links stop working.
SESSION_SECRET=
ENCRYPTION_KEY=

# First administrator (created on start if it does not exist yet)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Hostinger Mail API token (hPanel > Profile > API). Lets the admin create/delete mailboxes and reset
# passwords automatically. Empty = manual mode (create mailboxes in hPanel, then press "Verify").
HOSTINGER_API_TOKEN=

# Mail servers (defaults are Hostinger's; can also be changed in the admin panel)
# MAIL_PROTOCOL=imap
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# POP3_HOST=pop.hostinger.com
# POP3_PORT=995
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# First domain added on an empty database
# DEFAULT_DOMAIN=phuongcode.com
